{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.TokDar2410621/publiar",
  "title": "Publiar",
  "description": "Ecrit des lead magnets LinkedIn qui refusent d'inventer, rend le visuel et publie.",
  "version": "0.1.3",
  "repository": {
    "url": "https://github.com/TokDar2410621/publiar-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://publiar.app/icons/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://publiar.app/icons/icon-192.png",
      "mimeType": "image/png",
      "sizes": [
        "192x192"
      ]
    },
    {
      "src": "https://publiar.app/favicon.png",
      "mimeType": "image/png",
      "sizes": [
        "32x32"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "publiar-mcp",
      "version": "0.1.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "PUBLIAR_API_KEY",
          "description": "Cle MCP creee sur publiar.app/profile, section Cles MCP. Commence par mcp_pub_.",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "PUBLIAR_API_URL",
          "description": "Endpoint REST Publiar. Defaut : https://api.publiar.app/api",
          "isRequired": false,
          "isSecret": false,
          "format": "string"
        }
      ]
    }
  ]
}
